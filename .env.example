# Copier en .env (ignoré par git et par Docker) et remplir.
TOKEN_DISCORD=le_token_du_bot
EDITOR_ROLE_ID=123456789012345678
# Sans @ / : # ? (il est repris dans l'URL de connexion du bot).
# Doit être le mot de passe avec lequel la base a été créée : le changer ici ne change pas celui d'une base existante.
POSTGRES_PASSWORD=change_moi
